{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Enviar Atualizações para o GitHub e Vercel",
      "type": "shell",
      "command": "${workspaceFolder}\\enviar_atualizacoes.bat",
      "windows": {
        "command": "${workspaceFolder}\\enviar_atualizacoes.bat"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": []
    }
  ]
}
